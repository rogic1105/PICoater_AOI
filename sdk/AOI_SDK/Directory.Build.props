<Project>
	<PropertyGroup>
		<ParentPropsPath>$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))</ParentPropsPath>
	</PropertyGroup>

	<Import Project="$(ParentPropsPath)" Condition="Exists('$(ParentPropsPath)')" />

	<PropertyGroup>
		<SdkRoot>$(MSBuildThisFileDirectory)</SdkRoot>
	</PropertyGroup>

	<PropertyGroup Condition="'$(EngRoot)' == ''">
		<!-- standalone（整包拉出去獨立 build，沒有 repo 根 props）：
		     sdk 內部變數從 $(SdkRoot) 自帶，不再寄生 repo 根，ProjectReference 才解析得到。 -->
		<CoreCVPath>$(SdkRoot)core_cv\</CoreCVPath>
		<CoreCVBenchmarkPath>$(SdkRoot)core_cv_benchmark\</CoreCVBenchmarkPath>
		<CppUtilsPath>$(SdkRoot)cpp_utils\</CppUtilsPath>
		<FrameworkPath>$(SdkRoot)framework\</FrameworkPath>
		<StbPath>$(SdkRoot)third_party\stb\include\</StbPath>

		<OutDir>$(SdkRoot)bin\$(Platform)\$(Configuration)\</OutDir>
		<IntDir>$(SdkRoot)build\obj\$(MSBuildProjectName)\$(Platform)\$(Configuration)\</IntDir>

		<OutputPath>$(OutDir)</OutputPath>
		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
	</PropertyGroup>

	<ItemDefinitionGroup>
		<ClCompile>
			<AdditionalIncludeDirectories>$(CoreCVPath)src;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
		</ClCompile>
		<CudaCompile>
			<Include>$(CoreCVPath)src;%(Include)</Include>
		</CudaCompile>
	</ItemDefinitionGroup>

	<!-- standalone：沒有 repo 根全域 ItemDefinitionGroup，這裡重現 sdk 編譯所需的 header include
	     （monorepo 時 EngRoot != ''，不觸發，由 repo 根全域提供）。 -->
	<ItemDefinitionGroup Condition="'$(EngRoot)' == ''">
		<ClCompile>
			<AdditionalIncludeDirectories>$(CoreCVPath)include;$(FrameworkPath)include;$(CppUtilsPath)include;$(StbPath);%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
			<!-- framework/benchmark 編譯依賴這些（artifacts 輸出根 + 測試影像路徑）；
			     split 後沒 repo 測試資料，用 SdkRoot 佔位讓編譯過，執行時自備測試影像。 -->
			<PreprocessorDefinitions>REPO_ROOT=R"($(SdkRoot))";PGM_ROOT=R"($(SdkRoot))";PROJECT_ROOT=R"($(SdkRoot))";DEFAULT_TEST_IMAGE="";DATA_FOLDER_PATH="";TARGET_IMAGE_PATH="";%(PreprocessorDefinitions)</PreprocessorDefinitions>
		</ClCompile>
		<CudaCompile>
			<Include>$(CoreCVPath)include;$(FrameworkPath)include;$(CppUtilsPath)include;$(StbPath);%(Include)</Include>
		</CudaCompile>
	</ItemDefinitionGroup>

</Project>