<Project>
  <!-- 先繼承 repo 根 Directory.Build.props（取得 EngRoot / IntDir 等），再覆寫輸出位置 -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)..\'))" />

  <PropertyGroup>
    <!-- MIL 範例（MilGrabber.Monitor 多相機監控）的 exe 輸出到 bin/<plat>/<cfg>/tools/mil/，
         跟產品主程式分開 + 與 Bridge 工具（tools/io|light|storage）對稱。 -->
    <OutDir>$(EngRoot)bin\$(Platform)\$(Configuration)\tools\mil\</OutDir>
    <OutputPath>$(OutDir)</OutputPath>
  </PropertyGroup>
</Project>
