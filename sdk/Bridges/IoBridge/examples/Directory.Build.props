<Project>
  <!-- 先繼承 repo 根 Directory.Build.props（取得 EngRoot / IntDir 等），再覆寫輸出位置 -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)..\'))" />

  <PropertyGroup>
    <!-- examples（IoBridge 範例工具）的 exe 輸出到 bin/<plat>/<cfg>/tools/io/，
         跟產品主程式分開 + 按 Bridge 分項目（light/storage 未來對稱）。 -->
    <OutDir>$(EngRoot)bin\$(Platform)\$(Configuration)\tools\io\</OutDir>
    <OutputPath>$(OutDir)</OutputPath>
  </PropertyGroup>
</Project>
