{
  "Id": "report-verdict-warm-first",
  "Name": "Report first-load list and verdict performance",
  "Description": "Open the report once without clearing its rebuildable index and measure list plus column/row verdict presentation.",
  "Steps": [
    {
      "Id": "stage-empty-root",
      "Contract": "DVT.Setup",
      "Title": "Force an explicit report folder read",
      "Action": "set-session-value",
      "Target": "LastDataPath",
      "Value": "D:\\Anilox\\DvtEmpty",
      "TimeoutSeconds": 5
    },
    {
      "Id": "launch",
      "Contract": "F1",
      "Title": "Launch product",
      "Action": "launch",
      "TimeoutSeconds": 60
    },
    {
      "Id": "enable-flow-log",
      "Contract": "DVT.LogMode",
      "Title": "Enable flow verification log",
      "Action": "set-property",
      "Target": "記錄範圍",
      "Value": "流程驗證",
      "TimeoutSeconds": 10
    },
    {
      "Id": "open-report",
      "Contract": "D1",
      "Title": "Open report tab",
      "Action": "select-tab",
      "Target": "報表",
      "TimeoutSeconds": 15
    },
    {
      "Id": "evidence-boundary",
      "Contract": "D1.verdict-cache",
      "Title": "Reset timing evidence",
      "Action": "reset-evidence",
      "TimeoutSeconds": 5
    },
    {
      "Id": "first-read",
      "Contract": "D1.verdict-cache",
      "Title": "Read report data once",
      "Action": "confirm-folder",
      "Target": "讀取資料",
      "Value": "D:\\Anilox\\Captures",
      "TimeoutSeconds": 120
    },
    {
      "Id": "warm-cache-proof",
      "Contract": "D1.verdict-cache",
      "Title": "Require a complete daily-index hit",
      "Action": "wait-log",
      "Pattern": "DT verdict cache gen=[0-9]+ hits=([1-9][0-9]*)/\\1 days=[1-9][0-9]* loadMs=[0-9]+",
      "TimeoutSeconds": 120
    },
    {
      "Id": "warm-complete",
      "Contract": "D1.verdict-cache",
      "Title": "Require complete column and row verdicts",
      "Action": "wait-log",
      "Pattern": "DT verdict index apply=ok gen=[0-9]+ .* missing=0/[1-9][0-9]* .* ms=[0-9]+",
      "TimeoutSeconds": 120
    },
    {
      "Id": "verify-performance",
      "Contract": "D1.verdict-cache",
      "Title": "Verify first-load performance limits",
      "Action": "verify-verdict-cache-warm-first",
      "TimeoutSeconds": 10
    },
    {
      "Id": "restore-settings",
      "Contract": "DVT.Cleanup",
      "Title": "Restore settings",
      "Action": "restore-properties",
      "TimeoutSeconds": 30
    },
    {
      "Id": "close-app",
      "Contract": "G2.shutdown",
      "Title": "Close product",
      "Action": "close-app",
      "TimeoutSeconds": 60
    },
    {
      "Id": "shutdown-complete",
      "Contract": "G2.shutdown",
      "Title": "Verify resource cleanup",
      "Action": "wait-log",
      "Pattern": "shutdown resources released",
      "TimeoutSeconds": 60
    }
  ]
}
