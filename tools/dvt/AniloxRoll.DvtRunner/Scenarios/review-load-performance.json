{
  "Id": "review-load-performance",
  "Name": "回顧讀取與換序號效能",
  "Description": "量測 30,000 筆資料的首次索引、首筆顯示與快速換序號；不混入畫布拖曳或其他功能驗收。",
  "Category": "review",
  "ControlRefs": [ "tabPageReview", "btnReviewSelectFolder", "cbReviewId", "camReviewMain", "chartReviewColumn", "chartReviewRow" ],
  "Steps": [
    {
      "Id": "stage-review-root",
      "Contract": "DVT.Setup",
      "Title": "暫設大型資料集路徑",
      "Action": "set-session-value",
      "Target": "LastDataPath",
      "Value": "D:\\Anilox\\StressCaptures_30000",
      "TimeoutSeconds": 5
    },
    {
      "Id": "launch",
      "Contract": "F1",
      "Title": "開啟或連接監控程式",
      "Action": "launch",
      "TimeoutSeconds": 60
    },
    {
      "Id": "open-review",
      "Contract": "R1",
      "Title": "切到回顧",
      "Action": "select-tab",
      "Target": "回顧",
      "TimeoutSeconds": 15
    },
    {
      "Id": "review-evidence-boundary",
      "Contract": "R1",
      "Title": "切開首次讀取量測邊界",
      "Action": "reset-evidence",
      "TimeoutSeconds": 5
    },
    {
      "Id": "select-stress-folder",
      "Contract": "R1/D1",
      "Title": "讀取 30,000 筆測試資料",
      "Action": "confirm-folder",
      "Target": "讀取資料",
      "Value": "D:\\Anilox\\StressCaptures_30000",
      "TimeoutSeconds": 900
    },
    {
      "Id": "review-index-proof",
      "Contract": "R1",
      "Title": "等待索引完成",
      "Action": "wait-log",
      "Pattern": "RV repo scan root=D:\\\\Anilox\\\\StressCaptures_30000 files=[1-9][0-9]*",
      "TimeoutSeconds": 900
    },
    {
      "Id": "review-first-load",
      "Contract": "R1",
      "Title": "等待首筆圖片與曲線完成",
      "Action": "wait-log",
      "Pattern": "RV loadGrab done [0-9]{6}-[0-9]{6}",
      "TimeoutSeconds": 900
    },
    {
      "Id": "data-index-proof",
      "Contract": "D1",
      "Title": "等待首筆圖片後完成報表索引",
      "Action": "wait-log",
      "Pattern": "DT stats snapshot csv=[1-9][0-9]* records=[1-9][0-9]* grabs=30000 ms=[0-9]+",
      "TimeoutSeconds": 900
    },
    {
      "Id": "review-stats-ready",
      "Contract": "R1/D1",
      "Title": "確認影像與報表序號一致",
      "Action": "wait-log",
      "Pattern": "RV statistics ready grabs=30000 catalogMatch=True",
      "TimeoutSeconds": 900
    },
    {
      "Id": "review-scroll-boundary",
      "Contract": "R2",
      "Title": "切開快速換序號量測邊界",
      "Action": "reset-evidence",
      "TimeoutSeconds": 5
    },
    {
      "Id": "review-fast-scroll-forward",
      "Contract": "R2",
      "Title": "快速向前滾動序號 500 筆",
      "Action": "select-combo",
      "Target": "回顧序號",
      "Value": "next:500",
      "TimeoutSeconds": 120
    },
    {
      "Id": "review-fast-curve-forward",
      "Contract": "R2",
      "Title": "等待最後 Curve 落地",
      "Action": "wait-log-current-combo",
      "Target": "回顧序號",
      "Pattern": "RV curves {value}（[0-9]+ms）",
      "TimeoutSeconds": 120
    },
    {
      "Id": "review-fast-image-forward",
      "Contract": "R2",
      "Title": "等待最後完整圖片落地",
      "Action": "wait-log-current-combo",
      "Target": "回顧序號",
      "Pattern": "RV loadGrab done {value}",
      "TimeoutSeconds": 120
    },
    {
      "Id": "review-fast-scroll-back",
      "Contract": "R2",
      "Title": "快速反向滾回 500 筆",
      "Action": "select-combo",
      "Target": "回顧序號",
      "Value": "previous:500",
      "TimeoutSeconds": 120
    },
    {
      "Id": "review-fast-curve-back",
      "Contract": "R2",
      "Title": "等待反向最後 Curve 落地",
      "Action": "wait-log-current-combo",
      "Target": "回顧序號",
      "Pattern": "RV curves {value}（[0-9]+ms）",
      "TimeoutSeconds": 120
    },
    {
      "Id": "review-fast-image-back",
      "Contract": "R2",
      "Title": "等待反向最後完整圖片落地",
      "Action": "wait-log-current-combo",
      "Target": "回顧序號",
      "Pattern": "RV loadGrab done {value}",
      "TimeoutSeconds": 120
    },
    {
      "Id": "restore-settings",
      "Contract": "DVT.Cleanup",
      "Title": "還原 Runner 修改的設定",
      "Action": "restore-properties",
      "TimeoutSeconds": 15
    },
    {
      "Id": "close-app",
      "Contract": "G2.shutdown",
      "Title": "正常關閉主程式",
      "Action": "close-app",
      "TimeoutSeconds": 60
    },
    {
      "Id": "shutdown-complete",
      "Contract": "G2.shutdown",
      "Title": "確認資源釋放完成",
      "Action": "wait-log",
      "Pattern": "shutdown resources released",
      "TimeoutSeconds": 30
    }
  ]
}
