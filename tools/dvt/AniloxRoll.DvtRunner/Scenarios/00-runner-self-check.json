{
  "Id": "runner-self-check",
  "Name": "Runner 自我檢查（不 Grab）",
  "Description": "只驗證 UI 連接、PropertyGrid 提交、Flow tail 與設定還原，不操作相機 Grab。",
  "Category": "monitor",
  "ControlRefs": [ "tabPageLiveView", "propertyGridSettings" ],
  "Steps": [
    {
      "Id": "launch",
      "Contract": "DVT.LogMode",
      "Title": "開啟或連接監控程式",
      "Action": "launch",
      "TimeoutSeconds": 30
    },
    {
      "Id": "normalize-log-mode",
      "Contract": "DVT.LogMode",
      "Title": "正規化為日常運行記錄",
      "Action": "set-property",
      "Target": "記錄範圍",
      "Value": "日常運行",
      "TimeoutSeconds": 15
    },
    {
      "Id": "log-mode",
      "Contract": "DVT.LogMode",
      "Title": "切換為流程驗證記錄",
      "Action": "set-property",
      "Target": "記錄範圍",
      "Value": "流程驗證",
      "TimeoutSeconds": 15
    },
    {
      "Id": "log-mode-proof",
      "Contract": "DVT.LogMode",
      "Title": "確認 Flow marker",
      "Action": "wait-log",
      "Pattern": "log mode=FlowVerification",
      "TimeoutSeconds": 15
    },
    {
      "Id": "restore-settings",
      "Contract": "DVT.Cleanup",
      "Title": "還原 Runner 修改的設定",
      "Action": "restore-properties",
      "TimeoutSeconds": 15
    },
    {
      "Id": "close-app",
      "Contract": "G2.shutdown",
      "Title": "正常關閉主程式",
      "Action": "close-app",
      "TimeoutSeconds": 60
    },
    {
      "Id": "close-intent",
      "Contract": "G2.shutdown",
      "Title": "確認關閉 intent",
      "Action": "wait-log",
      "Pattern": "ui:關閉程式",
      "TimeoutSeconds": 10
    },
    {
      "Id": "shutdown-complete",
      "Contract": "G2.shutdown",
      "Title": "確認資源釋放完成",
      "Action": "wait-log",
      "Pattern": "shutdown resources released",
      "TimeoutSeconds": 30
    },
    {
      "Id": "checker",
      "Contract": "DVT",
      "Title": "執行所有已註冊 Flow 檢查器",
      "Action": "run-checker",
      "TimeoutSeconds": 120
    }
  ]
}
