{
  "Id": "physical-bridge-recovery",
  "Name": "IO／光源軟體斷線恢復",
  "Description": "以暫時黑洞路由阻斷實體 IO 192.168.255.1，並以 PnP 暫停實體光源 COM17；各重複三輪，驗證斷線、告警、自動重連及清理。",
  "Steps": [
    {
      "Id": "launch",
      "Contract": "F1/H1",
      "Title": "啟動檢測程式",
      "Action": "launch",
      "TimeoutSeconds": 30
    },
    {
      "Id": "normalize-log-mode",
      "Contract": "DVT.LogMode",
      "Title": "先回到日常記錄",
      "Action": "set-property",
      "Target": "記錄範圍",
      "Value": "日常運行",
      "TimeoutSeconds": 15
    },
    {
      "Id": "log-mode",
      "Contract": "DVT.LogMode",
      "Title": "開啟流程驗證記錄",
      "Action": "set-property",
      "Target": "記錄範圍",
      "Value": "流程驗證",
      "TimeoutSeconds": 15
    },
    {
      "Id": "log-mode-proof",
      "Contract": "DVT.LogMode",
      "Title": "確認 DVT 記錄已生效",
      "Action": "wait-log",
      "Pattern": "log mode=FlowVerification",
      "TimeoutSeconds": 15
    },
    {
      "Id": "io-endpoint-ip",
      "Contract": "H1",
      "Title": "設定實體 IO IP",
      "Action": "set-property",
      "Target": "IO IP",
      "Value": "192.168.255.1",
      "TimeoutSeconds": 15
    },
    {
      "Id": "io-endpoint-port",
      "Contract": "H1",
      "Title": "設定實體 IO Port",
      "Action": "set-property",
      "Target": "IO Port",
      "Value": "502",
      "TimeoutSeconds": 15
    },
    {
      "Id": "enable-physical-io",
      "Contract": "H1",
      "Title": "啟用實體 IO",
      "Action": "set-property",
      "Target": "啟用 IO",
      "Value": "是",
      "TimeoutSeconds": 15
    },
    {
      "Id": "light-port",
      "Contract": "H.Light",
      "Title": "設定實體光源串口",
      "Action": "set-property",
      "Target": "COM Port",
      "Value": "COM17",
      "TimeoutSeconds": 15
    },
    {
      "Id": "enable-light",
      "Contract": "H.Light",
      "Title": "啟用實體光源",
      "Action": "set-property",
      "Target": "啟用光源",
      "Value": "是",
      "TimeoutSeconds": 15
    },
    {
      "Id": "io-ready",
      "Contract": "H1",
      "Title": "等待 IO 進入待機",
      "Action": "wait-element",
      "Target": "待機",
      "TimeoutSeconds": 60
    },
    {
      "Id": "light-ready",
      "Contract": "H.Light",
      "Title": "等待光源連線",
      "Action": "wait-log",
      "Pattern": "\\[LightController\\] AutoDetect: (使用設定|掃描找到)",
      "TimeoutSeconds": 60
    },
    {
      "Id": "reset-evidence",
      "Contract": "H1/H.Light/C4",
      "Title": "清除初始化階段證據",
      "Action": "reset-evidence",
      "TimeoutSeconds": 5
    },

    {
      "Id": "io-block-1",
      "Contract": "H1",
      "Title": "第 1 輪阻斷 IO TCP",
      "Action": "block-target-port",
      "Target": "192.168.255.1:502",
      "TimeoutSeconds": 30
    },
    {
      "Id": "io-restart-off-1",
      "Contract": "H1",
      "Title": "第 1 輪關閉 IO controller",
      "Action": "set-property",
      "Target": "啟用 IO",
      "Value": "否",
      "TimeoutSeconds": 15
    },
    {
      "Id": "io-restart-on-1",
      "Contract": "H1",
      "Title": "第 1 輪在阻斷下重建 IO controller",
      "Action": "set-property",
      "Target": "啟用 IO",
      "Value": "是",
      "TimeoutSeconds": 15
    },
    {
      "Id": "io-down-1",
      "Contract": "H1",
      "Title": "第 1 輪確認 IO 斷線",
      "Action": "wait-log",
      "Pattern": "⚠ IO 斷線",
      "TimeoutSeconds": 20
    },
    {
      "Id": "io-health-raise-1",
      "Contract": "C4",
      "Title": "第 1 輪確認 IO 告警",
      "Action": "wait-log",
      "Pattern": "\\[OutputHealth\\] raise code=IoConnection ",
      "TimeoutSeconds": 10
    },
    {
      "Id": "io-unblock-1",
      "Contract": "H1",
      "Title": "第 1 輪恢復 IO TCP",
      "Action": "unblock-target-port",
      "Target": "io-block-1",
      "TimeoutSeconds": 30
    },
    {
      "Id": "io-up-1",
      "Contract": "H1",
      "Title": "第 1 輪確認 IO 恢復",
      "Action": "wait-log",
      "Pattern": "IO 恢復連線",
      "TimeoutSeconds": 30
    },
    {
      "Id": "io-health-resolve-1",
      "Contract": "C4",
      "Title": "第 1 輪確認 IO 告警解除",
      "Action": "wait-log",
      "Pattern": "\\[OutputHealth\\] resolve code=IoConnection ",
      "TimeoutSeconds": 10
    },

    {
      "Id": "io-block-2",
      "Contract": "H1",
      "Title": "第 2 輪阻斷 IO TCP",
      "Action": "block-target-port",
      "Target": "192.168.255.1:502",
      "TimeoutSeconds": 30
    },
    {
      "Id": "io-restart-off-2",
      "Contract": "H1",
      "Title": "第 2 輪關閉 IO controller",
      "Action": "set-property",
      "Target": "啟用 IO",
      "Value": "否",
      "TimeoutSeconds": 15
    },
    {
      "Id": "io-restart-on-2",
      "Contract": "H1",
      "Title": "第 2 輪在阻斷下重建 IO controller",
      "Action": "set-property",
      "Target": "啟用 IO",
      "Value": "是",
      "TimeoutSeconds": 15
    },
    {
      "Id": "io-down-2",
      "Contract": "H1",
      "Title": "第 2 輪確認 IO 斷線",
      "Action": "wait-log",
      "Pattern": "⚠ IO 斷線",
      "TimeoutSeconds": 20
    },
    {
      "Id": "io-health-raise-2",
      "Contract": "C4",
      "Title": "第 2 輪確認 IO 告警",
      "Action": "wait-log",
      "Pattern": "\\[OutputHealth\\] raise code=IoConnection ",
      "TimeoutSeconds": 10
    },
    {
      "Id": "io-unblock-2",
      "Contract": "H1",
      "Title": "第 2 輪恢復 IO TCP",
      "Action": "unblock-target-port",
      "Target": "io-block-2",
      "TimeoutSeconds": 30
    },
    {
      "Id": "io-up-2",
      "Contract": "H1",
      "Title": "第 2 輪確認 IO 恢復",
      "Action": "wait-log",
      "Pattern": "IO 恢復連線",
      "TimeoutSeconds": 30
    },
    {
      "Id": "io-health-resolve-2",
      "Contract": "C4",
      "Title": "第 2 輪確認 IO 告警解除",
      "Action": "wait-log",
      "Pattern": "\\[OutputHealth\\] resolve code=IoConnection ",
      "TimeoutSeconds": 10
    },

    {
      "Id": "io-block-3",
      "Contract": "H1",
      "Title": "第 3 輪阻斷 IO TCP",
      "Action": "block-target-port",
      "Target": "192.168.255.1:502",
      "TimeoutSeconds": 30
    },
    {
      "Id": "io-restart-off-3",
      "Contract": "H1",
      "Title": "第 3 輪關閉 IO controller",
      "Action": "set-property",
      "Target": "啟用 IO",
      "Value": "否",
      "TimeoutSeconds": 15
    },
    {
      "Id": "io-restart-on-3",
      "Contract": "H1",
      "Title": "第 3 輪在阻斷下重建 IO controller",
      "Action": "set-property",
      "Target": "啟用 IO",
      "Value": "是",
      "TimeoutSeconds": 15
    },
    {
      "Id": "io-down-3",
      "Contract": "H1",
      "Title": "第 3 輪確認 IO 斷線",
      "Action": "wait-log",
      "Pattern": "⚠ IO 斷線",
      "TimeoutSeconds": 20
    },
    {
      "Id": "io-health-raise-3",
      "Contract": "C4",
      "Title": "第 3 輪確認 IO 告警",
      "Action": "wait-log",
      "Pattern": "\\[OutputHealth\\] raise code=IoConnection ",
      "TimeoutSeconds": 10
    },
    {
      "Id": "io-unblock-3",
      "Contract": "H1",
      "Title": "第 3 輪恢復 IO TCP",
      "Action": "unblock-target-port",
      "Target": "io-block-3",
      "TimeoutSeconds": 30
    },
    {
      "Id": "io-up-3",
      "Contract": "H1",
      "Title": "第 3 輪確認 IO 恢復",
      "Action": "wait-log",
      "Pattern": "IO 恢復連線",
      "TimeoutSeconds": 30
    },
    {
      "Id": "io-health-resolve-3",
      "Contract": "C4",
      "Title": "第 3 輪確認 IO 告警解除",
      "Action": "wait-log",
      "Pattern": "\\[OutputHealth\\] resolve code=IoConnection ",
      "TimeoutSeconds": 10
    },

    {
      "Id": "light-restart-off-1",
      "Contract": "H.Light",
      "Title": "第 1 輪關閉光源 controller",
      "Action": "set-property",
      "Target": "啟用光源",
      "Value": "否",
      "TimeoutSeconds": 15
    },
    {
      "Id": "light-disable-1",
      "Contract": "H.Light",
      "Title": "第 1 輪暫停光源串口",
      "Action": "disable-serial-device",
      "Target": "COM17",
      "TimeoutSeconds": 30
    },
    {
      "Id": "light-restart-on-1",
      "Contract": "H.Light",
      "Title": "第 1 輪在停用下重建光源 controller",
      "Action": "set-property",
      "Target": "啟用光源",
      "Value": "是",
      "TimeoutSeconds": 15
    },
    {
      "Id": "light-down-1",
      "Contract": "H.Light",
      "Title": "第 1 輪確認光源斷線",
      "Action": "wait-log",
      "Pattern": "⚠ 光源 斷線",
      "TimeoutSeconds": 20
    },
    {
      "Id": "light-health-raise-1",
      "Contract": "C4",
      "Title": "第 1 輪確認光源告警",
      "Action": "wait-log",
      "Pattern": "\\[OutputHealth\\] raise code=LightConnection ",
      "TimeoutSeconds": 10
    },
    {
      "Id": "light-enable-1",
      "Contract": "H.Light",
      "Title": "第 1 輪恢復光源串口",
      "Action": "enable-serial-device",
      "Target": "light-disable-1",
      "TimeoutSeconds": 30
    },
    {
      "Id": "light-up-1",
      "Contract": "H.Light",
      "Title": "第 1 輪確認光源恢復",
      "Action": "wait-log",
      "Pattern": "光源 恢復連線",
      "TimeoutSeconds": 35
    },
    {
      "Id": "light-health-resolve-1",
      "Contract": "C4",
      "Title": "第 1 輪確認光源告警解除",
      "Action": "wait-log",
      "Pattern": "\\[OutputHealth\\] resolve code=LightConnection ",
      "TimeoutSeconds": 10
    },

    {
      "Id": "light-restart-off-2",
      "Contract": "H.Light",
      "Title": "第 2 輪關閉光源 controller",
      "Action": "set-property",
      "Target": "啟用光源",
      "Value": "否",
      "TimeoutSeconds": 15
    },
    {
      "Id": "light-disable-2",
      "Contract": "H.Light",
      "Title": "第 2 輪暫停光源串口",
      "Action": "disable-serial-device",
      "Target": "COM17",
      "TimeoutSeconds": 30
    },
    {
      "Id": "light-restart-on-2",
      "Contract": "H.Light",
      "Title": "第 2 輪在停用下重建光源 controller",
      "Action": "set-property",
      "Target": "啟用光源",
      "Value": "是",
      "TimeoutSeconds": 15
    },
    {
      "Id": "light-down-2",
      "Contract": "H.Light",
      "Title": "第 2 輪確認光源斷線",
      "Action": "wait-log",
      "Pattern": "⚠ 光源 斷線",
      "TimeoutSeconds": 20
    },
    {
      "Id": "light-health-raise-2",
      "Contract": "C4",
      "Title": "第 2 輪確認光源告警",
      "Action": "wait-log",
      "Pattern": "\\[OutputHealth\\] raise code=LightConnection ",
      "TimeoutSeconds": 10
    },
    {
      "Id": "light-enable-2",
      "Contract": "H.Light",
      "Title": "第 2 輪恢復光源串口",
      "Action": "enable-serial-device",
      "Target": "light-disable-2",
      "TimeoutSeconds": 30
    },
    {
      "Id": "light-up-2",
      "Contract": "H.Light",
      "Title": "第 2 輪確認光源恢復",
      "Action": "wait-log",
      "Pattern": "光源 恢復連線",
      "TimeoutSeconds": 35
    },
    {
      "Id": "light-health-resolve-2",
      "Contract": "C4",
      "Title": "第 2 輪確認光源告警解除",
      "Action": "wait-log",
      "Pattern": "\\[OutputHealth\\] resolve code=LightConnection ",
      "TimeoutSeconds": 10
    },

    {
      "Id": "light-restart-off-3",
      "Contract": "H.Light",
      "Title": "第 3 輪關閉光源 controller",
      "Action": "set-property",
      "Target": "啟用光源",
      "Value": "否",
      "TimeoutSeconds": 15
    },
    {
      "Id": "light-disable-3",
      "Contract": "H.Light",
      "Title": "第 3 輪暫停光源串口",
      "Action": "disable-serial-device",
      "Target": "COM17",
      "TimeoutSeconds": 30
    },
    {
      "Id": "light-restart-on-3",
      "Contract": "H.Light",
      "Title": "第 3 輪在停用下重建光源 controller",
      "Action": "set-property",
      "Target": "啟用光源",
      "Value": "是",
      "TimeoutSeconds": 15
    },
    {
      "Id": "light-down-3",
      "Contract": "H.Light",
      "Title": "第 3 輪確認光源斷線",
      "Action": "wait-log",
      "Pattern": "⚠ 光源 斷線",
      "TimeoutSeconds": 20
    },
    {
      "Id": "light-health-raise-3",
      "Contract": "C4",
      "Title": "第 3 輪確認光源告警",
      "Action": "wait-log",
      "Pattern": "\\[OutputHealth\\] raise code=LightConnection ",
      "TimeoutSeconds": 10
    },
    {
      "Id": "light-enable-3",
      "Contract": "H.Light",
      "Title": "第 3 輪恢復光源串口",
      "Action": "enable-serial-device",
      "Target": "light-disable-3",
      "TimeoutSeconds": 30
    },
    {
      "Id": "light-up-3",
      "Contract": "H.Light",
      "Title": "第 3 輪確認光源恢復",
      "Action": "wait-log",
      "Pattern": "光源 恢復連線",
      "TimeoutSeconds": 35
    },
    {
      "Id": "light-health-resolve-3",
      "Contract": "C4",
      "Title": "第 3 輪確認光源告警解除",
      "Action": "wait-log",
      "Pattern": "\\[OutputHealth\\] resolve code=LightConnection ",
      "TimeoutSeconds": 10
    },

    {
      "Id": "io-final",
      "Contract": "H1",
      "Title": "確認 IO 最終回到待機",
      "Action": "wait-element",
      "Target": "待機",
      "TimeoutSeconds": 20
    },
    {
      "Id": "restore-settings",
      "Contract": "DVT.Cleanup",
      "Title": "還原 Runner 改過的設定",
      "Action": "restore-properties",
      "TimeoutSeconds": 30
    },
    {
      "Id": "close-app",
      "Contract": "G2.shutdown",
      "Title": "正常關閉主程式",
      "Action": "close-app",
      "TimeoutSeconds": 60
    },
    {
      "Id": "shutdown-complete",
      "Contract": "G2.shutdown",
      "Title": "確認資源釋放完成",
      "Action": "wait-log",
      "Pattern": "shutdown resources released",
      "TimeoutSeconds": 30
    },
    {
      "Id": "checker",
      "Contract": "DVT",
      "Title": "執行完整 Flow 檢查",
      "Action": "run-checker",
      "TimeoutSeconds": 120
    }
  ]
}
