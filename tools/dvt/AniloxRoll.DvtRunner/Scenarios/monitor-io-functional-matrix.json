{
  "Id": "monitor-io-functional-matrix",
  "Name": "監控 IO／布局／檢測功能矩陣",
  "Description": "由 IoBridge.IoSimulator 觸發三輪真實 Grab，交叉驗證主畫面、欄列 Curve、方向、布局及檢測 O/X 公式。光源亮暗僅作檢測標準替代刺激，不代表真實 Mura。",
  "Category": "monitor",
  "ControlRefs": [ "tabPageLiveView", "btnLiveGrab", "camLiveMain", "chartLiveColumn", "chartLiveRow", "propertyGridSettings", "lblIoState" ],
  "Steps": [
    { "Id": "launch", "Contract": "F1", "Title": "啟動監控程式", "Action": "launch", "TimeoutSeconds": 30 },
    { "Id": "log-mode", "Contract": "DVT.LogMode", "Title": "開啟流程驗證記錄", "Action": "set-property", "Target": "記錄範圍", "Value": "流程驗證", "TimeoutSeconds": 15 },
    { "Id": "log-mode-proof", "Contract": "DVT.LogMode", "Title": "確認 DVT 探針開啟", "Action": "wait-log", "Pattern": "log mode=FlowVerification", "TimeoutSeconds": 15 },
    { "Id": "reset-light", "Contract": "H.Light", "Title": "重置光源連線週期", "Action": "set-property", "Target": "啟用光源", "Value": "否", "TimeoutSeconds": 15 },
    { "Id": "enable-light", "Contract": "H.Light", "Title": "啟用光源", "Action": "set-property", "Target": "啟用光源", "Value": "是", "TimeoutSeconds": 15 },
    { "Id": "wait-light", "Contract": "H.Light", "Title": "等待光源連線", "Action": "wait-log", "Pattern": "\\[LightController\\] AutoDetect: (使用設定|掃描找到)", "TimeoutSeconds": 60 },
    { "Id": "wait-cameras", "Contract": "F1/F2", "Title": "等待相機待機完成", "Action": "wait-log", "Pattern": "acquisition idle prepare ready cams=", "TimeoutSeconds": 180 },
    { "Id": "stop-io", "Contract": "F2.IO", "Title": "停止條件設為 IO", "Action": "set-property", "Target": "停止條件", "Value": "IO", "TimeoutSeconds": 15 },
    { "Id": "disable-save", "Contract": "C1", "Title": "功能矩陣不寫正式擷取資料", "Action": "set-property", "Target": "存檔", "Value": "否", "TimeoutSeconds": 15 },
    { "Id": "io-off", "Contract": "H1", "Title": "切換模擬器前停用 IO", "Action": "set-property", "Target": "啟用 IO", "Value": "否", "TimeoutSeconds": 15 },
    { "Id": "io-ip", "Contract": "H1", "Title": "IO 指向本機模擬器", "Action": "set-property", "Target": "IO IP", "Value": "127.0.0.1", "TimeoutSeconds": 15 },
    { "Id": "io-port", "Contract": "H1", "Title": "IO 模擬器使用 502", "Action": "set-property", "Target": "IO Port", "Value": "502", "TimeoutSeconds": 15 },
    { "Id": "io-on", "Contract": "H1", "Title": "啟用模擬 IO", "Action": "set-property", "Target": "啟用 IO", "Value": "是", "TimeoutSeconds": 15 },

    { "Id": "c1-mode", "Contract": "F4", "Title": "第一輪使用瀑布", "Action": "set-property", "Target": "主畫面顯示", "Value": "瀑布", "TimeoutSeconds": 15 },
    { "Id": "c1-direction", "Contract": "S2.Direction", "Title": "第一輪由下而上", "Action": "set-property", "Target": "上下方向", "Value": "由下而上", "TimeoutSeconds": 15 },
    { "Id": "c1-detect", "Contract": "S1", "Title": "第一輪欄列都檢出", "Action": "set-property", "Target": "檢出方向", "Value": "全部", "TimeoutSeconds": 15 },
    { "Id": "c1-curve-mode", "Contract": "S1", "Title": "第一輪欄列曲線顯示兩者", "Action": "set-property", "Target": "欄列曲線判定", "Value": "顯示兩者", "TimeoutSeconds": 15 },
    { "Id": "c1-col-norm", "Contract": "S1", "Title": "第一輪欄正規值", "Action": "set-property", "Target": "欄正規值", "Value": "0.5", "TimeoutSeconds": 15 },
    { "Id": "c1-row-norm", "Contract": "S1", "Title": "第一輪列正規值", "Action": "set-property", "Target": "列正規值", "Value": "0.5", "TimeoutSeconds": 15 },
    { "Id": "c1-col-mean", "Contract": "S1", "Title": "第一輪欄平均門檻", "Action": "set-property", "Target": "欄平均閾值", "Value": "0.2", "TimeoutSeconds": 15 },
    { "Id": "c1-col-max", "Contract": "S1", "Title": "第一輪欄最大門檻", "Action": "set-property", "Target": "欄最大閾值", "Value": "0.6", "TimeoutSeconds": 15 },
    { "Id": "c1-row-mean", "Contract": "S1", "Title": "第一輪列平均門檻", "Action": "set-property", "Target": "列平均閾值", "Value": "0.2", "TimeoutSeconds": 15 },
    { "Id": "c1-row-max", "Contract": "S1", "Title": "第一輪列最大門檻", "Action": "set-property", "Target": "列最大閾值", "Value": "0.6", "TimeoutSeconds": 15 },
    { "Id": "c1-crop-head", "Contract": "S2.Layout", "Title": "第一輪去頭歸零", "Action": "set-property", "Target": "去頭", "Value": "0", "TimeoutSeconds": 15 },
    { "Id": "c1-crop-tail", "Contract": "S2.Layout", "Title": "第一輪去尾歸零", "Action": "set-property", "Target": "去尾", "Value": "0", "TimeoutSeconds": 15 },
    { "Id": "c1-reset", "Contract": "DVT.MonitorFunctional", "Title": "開始第一輪證據窗", "Action": "reset-evidence", "TimeoutSeconds": 5 },
    { "Id": "c1-enhance-off", "Contract": "S1.Enhance", "Title": "重置第一輪強化狀態", "Action": "set-property", "Target": "監控強化", "Value": "否", "TimeoutSeconds": 15 },
    { "Id": "c1-enhance-on", "Contract": "S1.Enhance", "Title": "第一輪顯示欄強化", "Action": "set-property", "Target": "監控強化", "Value": "是", "TimeoutSeconds": 15 },
    { "Id": "c1-light-baseline", "Contract": "S1.LightSurrogate", "Title": "第一輪建立亮度刺激基線", "Action": "set-property", "Target": "亮度", "Value": "255", "TimeoutSeconds": 15 },
    { "Id": "simulator", "Contract": "H1/F2.IO", "Title": "啟動三輪 IO 模擬器", "Action": "launch-helper", "Target": "bin\\x64\\Release\\tools\\io\\IoBridge.IoSimulator.exe", "Value": "--auto --port 502 --cycles 3 --initial-delay-ms 30000 --high-ms 12000 --low-ms 55000 --exit-delay-ms 5000 --result-file D:\\Anilox\\Logs\\io-functional-matrix.txt", "TimeoutSeconds": 15 },
    { "Id": "io-controller", "Contract": "H1", "Title": "確認主程式連到模擬器", "Action": "wait-log", "Pattern": "IO 恢復連線", "TimeoutSeconds": 30 },

    { "Id": "c1-request", "Contract": "F2.IO", "Title": "第一輪 IO High", "Action": "wait-log", "Pattern": "IO grab request stopCondition=IoSignal stopOnLow=True", "TimeoutSeconds": 45 },
    { "Id": "c1-gate", "Contract": "F2.IO", "Title": "第一輪 Grab 開門", "Action": "wait-log", "Pattern": "capture gate open cams=", "TimeoutSeconds": 60 },
    { "Id": "c1-first", "Contract": "F2.IO", "Title": "第一輪相機首組到齊", "Action": "wait-log", "Pattern": "capture first-set ready .*aligned=True", "TimeoutSeconds": 30 },
    { "Id": "c1-band", "Contract": "F2.IO", "Title": "第一輪瀑布首組完整", "Action": "wait-log", "Pattern": "WF band first .*reason=complete", "TimeoutSeconds": 30 },
    { "Id": "c1-light", "Contract": "S1.LightSurrogate", "Title": "第一輪光源替代刺激", "Action": "set-property", "Target": "亮度", "Value": "100", "TimeoutSeconds": 15 },
    { "Id": "c1-stim-col", "Contract": "S1.LightSurrogate", "Title": "第一輪欄判定取樣", "Action": "wait-log", "Pattern": "live inspection stimulus brightness=100 direction=col .*threshold=0\\.2000/0\\.6000 .*source=light-surrogate-not-mura", "TimeoutSeconds": 30 },
    { "Id": "c1-stim-row", "Contract": "S1.LightSurrogate", "Title": "第一輪列判定取樣", "Action": "wait-log", "Pattern": "live inspection stimulus brightness=100 direction=row .*threshold=0\\.2000/0\\.6000 .*source=light-surrogate-not-mura", "TimeoutSeconds": 30 },
    { "Id": "c1-close", "Contract": "F3.IO", "Title": "第一輪 IO Low 關門", "Action": "wait-log", "Pattern": "capture gate closed standby=on", "TimeoutSeconds": 30 },
    { "Id": "c1-verify", "Contract": "DVT.MonitorFunctional", "Title": "驗證第一輪主畫面與欄列 Curve", "Action": "verify-monitor-functional-cycle", "Value": "mode=WF;direction=BottomToTop;layer=column;stimulus=col,row", "TimeoutSeconds": 10 },

    { "Id": "c2-reset", "Contract": "DVT.MonitorFunctional", "Title": "開始第二輪證據窗", "Action": "reset-evidence", "TimeoutSeconds": 5 },
    { "Id": "c2-mode", "Contract": "F4", "Title": "第二輪切即時畫面", "Action": "set-property", "Target": "主畫面顯示", "Value": "即時", "TimeoutSeconds": 15 },
    { "Id": "c2-direction", "Contract": "S2.Direction", "Title": "第二輪由上而下", "Action": "set-property", "Target": "上下方向", "Value": "由上而下", "TimeoutSeconds": 15 },
    { "Id": "c2-ops", "Contract": "S2.Layout", "Title": "第二輪調整 Cam1 OPS", "Action": "set-property", "Target": "Cam 1", "TargetOccurrence": 0, "Value": "24.5", "TimeoutSeconds": 15 },
    { "Id": "c2-start", "Contract": "S2.Layout", "Title": "第二輪調整 Cam2 Start", "Action": "set-property", "Target": "Cam 2", "TargetOccurrence": 1, "Value": "346", "TimeoutSeconds": 15 },
    { "Id": "c2-crop-head", "Contract": "S2.Layout", "Title": "第二輪去頭", "Action": "set-property", "Target": "去頭", "Value": "10", "TimeoutSeconds": 15 },
    { "Id": "c2-crop-tail", "Contract": "S2.Layout", "Title": "第二輪去尾", "Action": "set-property", "Target": "去尾", "Value": "20", "TimeoutSeconds": 15 },
    { "Id": "c2-layout-proof", "Contract": "S2.Layout", "Title": "第二輪布局已進主畫面與欄圖表", "Action": "wait-log", "Pattern": "displayLayout applied setting=bc_StartCam2 refGrid=cam1 ops=24\\.5000\\d*\\|.* start=[^ ]*\\|346\\.0000\\|.* scope=main\\+column-chart source=unchanged", "TimeoutSeconds": 30 },
    { "Id": "c2-crop-proof", "Contract": "S2.Layout", "Title": "第二輪裁切已進顯示層", "Action": "wait-log", "Pattern": "displayCrop applied head=10\\.00 tail=20\\.00 mode=IC .*frames=dynamic", "TimeoutSeconds": 30 },
    { "Id": "c2-detect", "Contract": "S1", "Title": "第二輪只判欄", "Action": "set-property", "Target": "檢出方向", "Value": "欄", "TimeoutSeconds": 15 },
    { "Id": "c2-curve-mode", "Contract": "S1", "Title": "第二輪欄列只顯示平均", "Action": "set-property", "Target": "欄列曲線判定", "Value": "顯示平均", "TimeoutSeconds": 15 },
    { "Id": "c2-col-norm", "Contract": "S1", "Title": "第二輪欄正規值", "Action": "set-property", "Target": "欄正規值", "Value": "0.47", "TimeoutSeconds": 15 },
    { "Id": "c2-row-norm", "Contract": "S1", "Title": "第二輪列正規值", "Action": "set-property", "Target": "列正規值", "Value": "0.83", "TimeoutSeconds": 15 },
    { "Id": "c2-col-mean", "Contract": "S1", "Title": "第二輪欄平均門檻", "Action": "set-property", "Target": "欄平均閾值", "Value": "0.31", "TimeoutSeconds": 15 },
    { "Id": "c2-col-max", "Contract": "S1", "Title": "第二輪欄最大門檻", "Action": "set-property", "Target": "欄最大閾值", "Value": "0.71", "TimeoutSeconds": 15 },
    { "Id": "c2-enhance-off", "Contract": "S1.Enhance", "Title": "重置第二輪強化狀態", "Action": "set-property", "Target": "監控強化", "Value": "否", "TimeoutSeconds": 15 },
    { "Id": "c2-enhance-on", "Contract": "S1.Enhance", "Title": "第二輪顯示欄強化", "Action": "set-property", "Target": "監控強化", "Value": "是", "TimeoutSeconds": 15 },
    { "Id": "c2-request", "Contract": "F2.IO", "Title": "第二輪 IO High", "Action": "wait-log", "Pattern": "IO grab request stopCondition=IoSignal stopOnLow=True", "TimeoutSeconds": 75 },
    { "Id": "c2-gate", "Contract": "F2.IO", "Title": "第二輪 Grab 開門", "Action": "wait-log", "Pattern": "capture gate open cams=", "TimeoutSeconds": 60 },
    { "Id": "c2-first", "Contract": "F2.IO", "Title": "第二輪相機首組到齊", "Action": "wait-log", "Pattern": "capture first-set ready .*aligned=True", "TimeoutSeconds": 30 },
    { "Id": "c2-light", "Contract": "S1.LightSurrogate", "Title": "第二輪光源替代刺激", "Action": "set-property", "Target": "亮度", "Value": "255", "TimeoutSeconds": 15 },
    { "Id": "c2-stim-col", "Contract": "S1.LightSurrogate", "Title": "第二輪欄判定取樣", "Action": "wait-log", "Pattern": "live inspection stimulus brightness=255 direction=col .*threshold=0\\.3100/0\\.7100 mode=Mean .*source=light-surrogate-not-mura", "TimeoutSeconds": 30 },
    { "Id": "c2-close", "Contract": "F3.IO", "Title": "第二輪 IO Low 關門", "Action": "wait-log", "Pattern": "capture gate closed standby=on", "TimeoutSeconds": 30 },
    { "Id": "c2-verify", "Contract": "DVT.MonitorFunctional", "Title": "驗證第二輪主畫面與欄列 Curve", "Action": "verify-monitor-functional-cycle", "Value": "mode=IC;direction=TopToBottom;layer=column;stimulus=col", "TimeoutSeconds": 10 },

    { "Id": "c3-reset", "Contract": "DVT.MonitorFunctional", "Title": "開始第三輪證據窗", "Action": "reset-evidence", "TimeoutSeconds": 5 },
    { "Id": "c3-mode", "Contract": "F4", "Title": "第三輪回瀑布", "Action": "set-property", "Target": "主畫面顯示", "Value": "瀑布", "TimeoutSeconds": 15 },
    { "Id": "c3-direction", "Contract": "S2.Direction", "Title": "第三輪由下而上", "Action": "set-property", "Target": "上下方向", "Value": "由下而上", "TimeoutSeconds": 15 },
    { "Id": "c3-ops", "Contract": "S2.Layout", "Title": "第三輪再次調整 Cam1 OPS", "Action": "set-property", "Target": "Cam 1", "TargetOccurrence": 0, "Value": "24.6", "TimeoutSeconds": 15 },
    { "Id": "c3-start", "Contract": "S2.Layout", "Title": "第三輪再次調整 Cam2 Start", "Action": "set-property", "Target": "Cam 2", "TargetOccurrence": 1, "Value": "347", "TimeoutSeconds": 15 },
    { "Id": "c3-crop-head", "Contract": "S2.Layout", "Title": "第三輪去頭", "Action": "set-property", "Target": "去頭", "Value": "5", "TimeoutSeconds": 15 },
    { "Id": "c3-crop-tail", "Contract": "S2.Layout", "Title": "第三輪去尾", "Action": "set-property", "Target": "去尾", "Value": "15", "TimeoutSeconds": 15 },
    { "Id": "c3-detect", "Contract": "S1", "Title": "第三輪只判列", "Action": "set-property", "Target": "檢出方向", "Value": "列", "TimeoutSeconds": 15 },
    { "Id": "c3-col-norm", "Contract": "S1", "Title": "第三輪欄正規值", "Action": "set-property", "Target": "欄正規值", "Value": "0.8", "TimeoutSeconds": 15 },
    { "Id": "c3-row-norm", "Contract": "S1", "Title": "第三輪列正規值", "Action": "set-property", "Target": "列正規值", "Value": "0.4", "TimeoutSeconds": 15 },
    { "Id": "c3-row-mean", "Contract": "S1", "Title": "第三輪列平均門檻", "Action": "set-property", "Target": "列平均閾值", "Value": "0.29", "TimeoutSeconds": 15 },
    { "Id": "c3-row-max", "Contract": "S1", "Title": "第三輪列最大門檻", "Action": "set-property", "Target": "列最大閾值", "Value": "0.69", "TimeoutSeconds": 15 },
    { "Id": "c3-curve-mode", "Contract": "S1", "Title": "第三輪欄列曲線顯示兩者", "Action": "set-property", "Target": "欄列曲線判定", "Value": "顯示兩者", "TimeoutSeconds": 15 },
    { "Id": "c3-row-layer", "Contract": "S1.Enhance", "Title": "第三輪切換列強化主畫面", "Action": "click-control", "Target": "chartLiveRow", "TimeoutSeconds": 20 },
    { "Id": "c3-layer-proof", "Contract": "S1.Enhance", "Title": "確認第三輪列強化套到所有相機", "Action": "wait-log", "Pattern": "live enhance enabled=True direction=row cams=\\d+ scope=all-cameras waterfallHistory=preserved", "TimeoutSeconds": 20 },
    { "Id": "c3-request", "Contract": "F2.IO", "Title": "第三輪 IO High", "Action": "wait-log", "Pattern": "IO grab request stopCondition=IoSignal stopOnLow=True", "TimeoutSeconds": 75 },
    { "Id": "c3-gate", "Contract": "F2.IO", "Title": "第三輪 Grab 開門", "Action": "wait-log", "Pattern": "capture gate open cams=", "TimeoutSeconds": 60 },
    { "Id": "c3-first", "Contract": "F2.IO", "Title": "第三輪相機首組到齊", "Action": "wait-log", "Pattern": "capture first-set ready .*aligned=True", "TimeoutSeconds": 30 },
    { "Id": "c3-band", "Contract": "F2.IO", "Title": "第三輪瀑布首組完整", "Action": "wait-log", "Pattern": "WF band first .*reason=complete", "TimeoutSeconds": 30 },
    { "Id": "c3-light", "Contract": "S1.LightSurrogate", "Title": "第三輪光源替代刺激", "Action": "set-property", "Target": "亮度", "Value": "100", "TimeoutSeconds": 15 },
    { "Id": "c3-stim-row", "Contract": "S1.LightSurrogate", "Title": "第三輪列判定取樣", "Action": "wait-log", "Pattern": "live inspection stimulus brightness=100 direction=row .*threshold=0\\.2900/0\\.6900 mode=Both .*source=light-surrogate-not-mura", "TimeoutSeconds": 30 },
    { "Id": "c3-close", "Contract": "F3.IO", "Title": "第三輪 IO Low 關門", "Action": "wait-log", "Pattern": "capture gate closed standby=on", "TimeoutSeconds": 30 },
    { "Id": "c3-verify", "Contract": "DVT.MonitorFunctional", "Title": "驗證第三輪主畫面與欄列 Curve", "Action": "verify-monitor-functional-cycle", "Value": "mode=WF;direction=BottomToTop;layer=row;stimulus=row", "TimeoutSeconds": 10 },
    { "Id": "simulator-exit", "Contract": "H1/F3.IO", "Title": "確認 IO 模擬器完整結束", "Action": "wait-helper-exit", "Target": "simulator", "TimeoutSeconds": 90 },
    { "Id": "restore", "Contract": "DVT.Cleanup", "Title": "還原所有設定", "Action": "restore-properties", "TimeoutSeconds": 90 },
    { "Id": "close", "Contract": "G2.shutdown", "Title": "正常關閉監控程式", "Action": "close-app", "TimeoutSeconds": 60 },
    { "Id": "shutdown", "Contract": "G2.shutdown", "Title": "確認資源釋放", "Action": "wait-log", "Pattern": "shutdown resources released", "TimeoutSeconds": 30 },
    { "Id": "checker", "Contract": "DVT", "Title": "執行完整 Flow checker", "Action": "run-checker", "TimeoutSeconds": 180 }
  ]
}
