{
  "Id": "monitor-column-range-stability",
  "Name": "監控欄圖表座標範圍穩定性",
  "Description": "由 IoBridge.IoSimulator 觸發真實 Grab；在主畫面執行滑鼠滾輪後等待 Curve 刷新，再反覆更新欄正規值與欄列曲線模式，禁止欄圖表 X 範圍被資料重畫拉回預設值。",
  "Category": "monitor",
  "ControlRefs": [ "tabPageLiveView", "camLiveMain", "chartLiveColumn", "propertyGridSettings", "lblIoState" ],
  "Steps": [
    { "Id": "launch", "Contract": "F1", "Title": "啟動監控程式", "Action": "launch", "TimeoutSeconds": 30 },
    { "Id": "log-mode", "Contract": "DVT.LogMode", "Title": "開啟流程驗證記錄", "Action": "set-property", "Target": "記錄範圍", "Value": "流程驗證", "TimeoutSeconds": 15 },
    { "Id": "log-mode-proof", "Contract": "DVT.LogMode", "Title": "確認 DVT 探針開啟", "Action": "wait-log", "Pattern": "log mode=FlowVerification", "TimeoutSeconds": 15 },
    { "Id": "wait-cameras", "Contract": "F1/F2", "Title": "等待相機待機完成", "Action": "wait-log", "Pattern": "acquisition idle prepare ready cams=", "TimeoutSeconds": 180 },
    { "Id": "stop-io", "Contract": "F2.IO", "Title": "停止條件設為 IO", "Action": "set-property", "Target": "停止條件", "Value": "IO", "TimeoutSeconds": 15 },
    { "Id": "display-ic", "Contract": "F4", "Title": "先建立不同的顯示基線", "Action": "set-property", "Target": "主畫面顯示", "Value": "即時", "TimeoutSeconds": 15 },
    { "Id": "curve-both", "Contract": "S1", "Title": "欄圖表先顯示平均與最大", "Action": "set-property", "Target": "欄列曲線判定", "Value": "顯示兩者", "TimeoutSeconds": 15 },
    { "Id": "io-off", "Contract": "H1", "Title": "切換模擬器前停用 IO", "Action": "set-property", "Target": "啟用 IO", "Value": "否", "TimeoutSeconds": 15 },
    { "Id": "io-ip", "Contract": "H1", "Title": "IO 指向本機模擬器", "Action": "set-property", "Target": "IO IP", "Value": "127.0.0.1", "TimeoutSeconds": 15 },
    { "Id": "io-port", "Contract": "H1", "Title": "IO 模擬器使用 502", "Action": "set-property", "Target": "IO Port", "Value": "502", "TimeoutSeconds": 15 },
    { "Id": "io-on", "Contract": "H1", "Title": "啟用模擬 IO", "Action": "set-property", "Target": "啟用 IO", "Value": "是", "TimeoutSeconds": 15 },
    { "Id": "evidence", "Contract": "F2.ColumnRange", "Title": "開始欄座標範圍證據窗", "Action": "reset-evidence", "TimeoutSeconds": 5 },
    { "Id": "display-wf", "Contract": "F4", "Title": "切換並固定瀑布主畫面", "Action": "set-property", "Target": "主畫面顯示", "Value": "瀑布", "TimeoutSeconds": 15 },
    { "Id": "simulator", "Contract": "H1/F2.IO", "Title": "啟動 IO 模擬器一循環", "Action": "launch-helper", "Target": "bin\\x64\\Release\\tools\\io\\IoBridge.IoSimulator.exe", "Value": "--auto --port 502 --cycles 1 --initial-delay-ms 15000 --high-ms 60000 --low-ms 2000 --exit-delay-ms 2000 --result-file D:\\Anilox\\Logs\\io-column-range-stability.txt", "TimeoutSeconds": 15 },
    { "Id": "io-ready", "Contract": "H1", "Title": "確認主程式連上模擬器", "Action": "wait-log", "Pattern": "IO 恢復連線", "TimeoutSeconds": 30 },
    { "Id": "gate", "Contract": "F2.IO", "Title": "等待 Grab 開門", "Action": "wait-log", "Pattern": "capture gate open cams=", "TimeoutSeconds": 45 },
    { "Id": "column-range", "Contract": "F2.ColumnRange", "Title": "取得欄圖表初始 X 範圍", "Action": "wait-log", "Pattern": "LC colRange source=data target=", "TimeoutSeconds": 30 },
    { "Id": "main-wheel", "Contract": "F2.ColumnRange", "Title": "Grab 中滾動主畫面改變視野", "Action": "wheel", "Target": "camLiveMain", "Value": "600", "TimeoutSeconds": 15 },
    { "Id": "main-wheel-proof", "Contract": "F2.ColumnRange", "Title": "確認主畫面滾輪事件", "Action": "wait-log", "Pattern": "WF wheelZoom in", "TimeoutSeconds": 15 },
    { "Id": "main-wheel-range", "Contract": "F2.ColumnRange", "Title": "確認欄圖表收到滾輪後視野", "Action": "wait-log", "Pattern": "LC colRange source=view target=", "TimeoutSeconds": 15 },
    { "Id": "main-wheel-redraw", "Contract": "F2.ColumnRange", "Title": "等待 Curve 刷新後仍維持滾輪視野", "Action": "delay", "Value": "2", "TimeoutSeconds": 5 },
    { "Id": "norm-low", "Contract": "S1/F2.ColumnRange", "Title": "降低欄正規值並重畫", "Action": "set-property", "Target": "欄正規值", "Value": "0.4", "TimeoutSeconds": 15 },
    { "Id": "norm-low-proof", "Contract": "F2.ColumnRange", "Title": "量測低正規值後範圍", "Action": "wait-log", "Pattern": "LC colRange source=data target=", "TimeoutSeconds": 15 },
    { "Id": "curve-mean", "Contract": "S1/F2.ColumnRange", "Title": "切換只顯示平均並重畫", "Action": "set-property", "Target": "欄列曲線判定", "Value": "顯示平均", "TimeoutSeconds": 15 },
    { "Id": "curve-mean-proof", "Contract": "F2.ColumnRange", "Title": "量測平均模式範圍", "Action": "wait-log", "Pattern": "LC colRange source=data target=", "TimeoutSeconds": 15 },
    { "Id": "norm-high", "Contract": "S1/F2.ColumnRange", "Title": "提高欄正規值並重畫", "Action": "set-property", "Target": "欄正規值", "Value": "1.2", "TimeoutSeconds": 15 },
    { "Id": "norm-high-proof", "Contract": "F2.ColumnRange", "Title": "量測高正規值後範圍", "Action": "wait-log", "Pattern": "LC colRange source=data target=", "TimeoutSeconds": 15 },
    { "Id": "curve-max", "Contract": "S1/F2.ColumnRange", "Title": "切換只顯示最大並重畫", "Action": "set-property", "Target": "欄列曲線判定", "Value": "顯示最大", "TimeoutSeconds": 15 },
    { "Id": "curve-max-proof", "Contract": "F2.ColumnRange", "Title": "量測最大模式範圍", "Action": "wait-log", "Pattern": "LC colRange source=data target=", "TimeoutSeconds": 15 },
    { "Id": "verify", "Contract": "F2.ColumnRange", "Title": "比較主畫面與欄圖表座標穩定性", "Action": "verify-live-column-range", "TimeoutSeconds": 10 },
    { "Id": "gate-close", "Contract": "F3.IO", "Title": "等待 IO Low 關閉 Grab", "Action": "wait-log", "Pattern": "capture gate closed standby=on", "TimeoutSeconds": 60 },
    { "Id": "simulator-exit", "Contract": "H1/F3.IO", "Title": "確認 IO 模擬器結束", "Action": "wait-helper-exit", "Target": "simulator", "TimeoutSeconds": 30 },
    { "Id": "restore", "Contract": "DVT.Cleanup", "Title": "還原設定", "Action": "restore-properties", "TimeoutSeconds": 60 },
    { "Id": "close", "Contract": "G2.shutdown", "Title": "正常關閉監控程式", "Action": "close-app", "TimeoutSeconds": 60 },
    { "Id": "shutdown", "Contract": "G2.shutdown", "Title": "確認資源釋放", "Action": "wait-log", "Pattern": "shutdown resources released", "TimeoutSeconds": 30 },
    { "Id": "checker", "Contract": "DVT", "Title": "執行完整 Flow checker", "Action": "run-checker", "TimeoutSeconds": 180 }
  ]
}
