{
  "Id": "monitor-io-pause-high",
  "Name": "監控 IO High 期間暫停",
  "Description": "由 IoBridge.IoSimulator 在 DI High 開啟真實 Grab，High 期間按下 IO 暫停；暫停只封鎖新 Start，後續 Low 仍必須排水並關閉本輪 Grab。",
  "Category": "monitor",
  "ControlRefs": [ "tabPageLiveView", "btnLiveGrab", "lblIoConn", "lblIoState", "camLiveMain" ],
  "Steps": [
    { "Id": "launch", "Contract": "F1", "Title": "開啟監控程式", "Action": "launch", "TimeoutSeconds": 30 },
    { "Id": "log-mode", "Contract": "DVT.LogMode", "Title": "開啟流程驗證記錄", "Action": "set-property", "Target": "記錄範圍", "Value": "流程驗證", "TimeoutSeconds": 15 },
    { "Id": "log-mode-proof", "Contract": "DVT.LogMode", "Title": "確認 DVT 探針開啟", "Action": "wait-log", "Pattern": "log mode=FlowVerification", "TimeoutSeconds": 15 },
    { "Id": "light-ready", "Contract": "H.Light", "Title": "等待光源連線", "Action": "wait-log", "Pattern": "\\[LightController\\] AutoDetect: (使用設定|掃描找到)", "TimeoutSeconds": 60 },
    { "Id": "camera-ready", "Contract": "F1/F2", "Title": "等待相機待機完成", "Action": "wait-log", "Pattern": "acquisition idle prepare ready cams=", "TimeoutSeconds": 180 },
    { "Id": "stop-io", "Contract": "F2.IO", "Title": "停止條件設為 IO", "Action": "set-property", "Target": "停止條件", "Value": "IO", "TimeoutSeconds": 15 },
    { "Id": "save-off", "Contract": "C1", "Title": "本測試不保存影像", "Action": "set-property", "Target": "存檔", "Value": "否", "TimeoutSeconds": 15 },
    { "Id": "io-off", "Contract": "H1", "Title": "切換 endpoint 前停用 IO", "Action": "set-property", "Target": "啟用 IO", "Value": "否", "TimeoutSeconds": 15 },
    { "Id": "io-ip", "Contract": "H1", "Title": "IO 指向本機模擬器", "Action": "set-property", "Target": "IO IP", "Value": "127.0.0.1", "TimeoutSeconds": 15 },
    { "Id": "io-port", "Contract": "H1", "Title": "IO 使用 502", "Action": "set-property", "Target": "IO Port", "Value": "502", "TimeoutSeconds": 15 },
    { "Id": "io-on", "Contract": "H1", "Title": "啟用 IO", "Action": "set-property", "Target": "啟用 IO", "Value": "是", "TimeoutSeconds": 15 },
    { "Id": "evidence", "Contract": "F2.IO", "Title": "開始暫停邊界證據窗", "Action": "reset-evidence", "TimeoutSeconds": 5 },
    { "Id": "simulator", "Contract": "H1/F2.IO", "Title": "啟動 IO 模擬器一循環", "Action": "launch-helper", "Target": "bin\\x64\\Release\\tools\\io\\IoBridge.IoSimulator.exe", "Value": "--auto --port 502 --cycles 1 --initial-delay-ms 10000 --high-ms 15000 --low-ms 3000 --exit-delay-ms 2000 --result-file D:\\Anilox\\Logs\\io-pause-high.txt", "TimeoutSeconds": 15 },
    { "Id": "io-ready", "Contract": "H1", "Title": "確認主程式連上模擬器", "Action": "wait-log", "Pattern": "IO 恢復連線", "TimeoutSeconds": 30 },
    { "Id": "high", "Contract": "F2.IO", "Title": "High 送出 Grab 請求", "Action": "wait-log", "Pattern": "IO grab request stopCondition=IoSignal stopOnLow=True", "TimeoutSeconds": 30 },
    { "Id": "gate-open", "Contract": "F2.IO", "Title": "Grab 閘門開啟", "Action": "wait-log", "Pattern": "capture gate open cams=", "TimeoutSeconds": 30 },
    { "Id": "pause", "Contract": "F2.IO.Pause", "Title": "DI High 期間按下 IO 暫停", "Action": "click-control", "Target": "lblIoConn", "TimeoutSeconds": 15 },
    { "Id": "pause-policy", "Contract": "F2.IO.Pause", "Title": "暫停保留本輪 Low 停止權", "Action": "wait-log", "Pattern": "IO pause activeCapture=True stopCondition=IoSignal preserveTerminalStop=True", "TimeoutSeconds": 15 },
    { "Id": "low-stop", "Contract": "F3.IO.Pause", "Title": "暫停中 Low 仍接受停止", "Action": "wait-log", "Pattern": "IO grab stop accepted reason=StartLow stopCondition=IoSignal drainTail=True", "TimeoutSeconds": 30 },
    { "Id": "tail", "Contract": "F3.IO", "Title": "Low 進入尾幀排水", "Action": "wait-log", "Pattern": "capture tail begin cams=", "TimeoutSeconds": 20 },
    { "Id": "gate-close", "Contract": "F3.IO", "Title": "尾幀完成後關閉 Grab", "Action": "wait-log", "Pattern": "capture gate closed standby=on", "TimeoutSeconds": 30 },
    { "Id": "resume", "Contract": "F2.IO.Pause", "Title": "恢復 IO 監聽", "Action": "click-control", "Target": "lblIoConn", "TimeoutSeconds": 15 },
    { "Id": "resume-proof", "Contract": "F2.IO.Pause", "Title": "確認 IO 已恢復", "Action": "wait-log", "Pattern": "ui:【IO暫停】鈕 → 恢復", "TimeoutSeconds": 15 },
    { "Id": "simulator-exit", "Contract": "H1/F3.IO", "Title": "IO 模擬器正常結束", "Action": "wait-helper-exit", "Target": "simulator", "TimeoutSeconds": 30 },
    { "Id": "restore", "Contract": "DVT.Cleanup", "Title": "還原設定", "Action": "restore-properties", "TimeoutSeconds": 45 },
    { "Id": "close", "Contract": "G2.shutdown", "Title": "正常關閉主程式", "Action": "close-app", "TimeoutSeconds": 60 },
    { "Id": "shutdown", "Contract": "G2.shutdown", "Title": "確認資源釋放", "Action": "wait-log", "Pattern": "shutdown resources released", "TimeoutSeconds": 30 }
  ]
}
